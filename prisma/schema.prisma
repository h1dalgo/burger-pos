generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  displayOrder Int       @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  products     Product[]

  @@map("categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  name           String
  description    String
  basePrice      Decimal   @map("base_price") @db.Decimal(10, 2)
  imageUrl       String?   @map("image_url")
  isAvailable    Boolean   @default(true) @map("is_available")
  hasVariation   Boolean   @default(false) @map("has_variation")
  isFeatured     Boolean   @default(false) @map("is_featured") // sale en el escaparate del menú
  allergens      String[]  @default([]) // "Gluten", "Lácteos"... se muestran al cliente
  createdAt      DateTime  @default(now()) @map("created_at")

  category          Category              @relation(fields: [categoryId], references: [id])
  variations        ProductVariation[]
  defaultIngredients DefaultIngredient[]
  extraIngredients   ExtraIngredient[]
  requiredSelections RequiredSelection[]
  orderItems         OrderItem[]
  inventoryUsages    InventoryUsage[]

  @@map("products")
}

model ProductVariation {
  id              String  @id @default(uuid()) @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  name            String
  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)
  isAvailable     Boolean @default(true) @map("is_available")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variations")
}

model RequiredSelection {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  label         String
  maxSelections Int     @default(1) @map("max_selections")

  product Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  options RequiredSelectionOption[]

  @@map("required_selections")
}

model RequiredSelectionOption {
  id                  String  @id @default(uuid()) @db.Uuid
  requiredSelectionId String  @map("required_selection_id") @db.Uuid
  name                String
  additionalPrice     Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)
  isAvailable         Boolean @default(true) @map("is_available")

  requiredSelection RequiredSelection @relation(fields: [requiredSelectionId], references: [id], onDelete: Cascade)

  @@map("required_selection_options")
}

model DefaultIngredient {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  name      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("default_ingredients")
}

model ExtraIngredient {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  name        String
  basePrice   Decimal @default(1.00) @map("base_price") @db.Decimal(10, 2)
  isAvailable Boolean @default(true) @map("is_available")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("extra_ingredients")
}

enum OrderStatus {
  WAITING_PAYMENT
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_PAYMENT
  CARD
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  displayId     Int           @default(autoincrement()) @map("display_id")
  customerName  String        @map("customer_name")
  tableNumber   String        @map("table_number")
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  tip           Decimal       @default(0) @db.Decimal(10, 2)
  waiter        String?
  /// Número de referencia del Pago Móvil (lo escribe el cliente)
  paymentReference String?    @map("payment_reference")
  /// Descuento aplicado (promociones / cupón), ya restado de totalAmount
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  promoLabel    String?       @map("promo_label")
  /// Tasa Bs/$ del momento del pedido
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(14, 4)
  rating        Int?
  ratingComment String?       @map("rating_comment")
  cancelReason  String?       @map("cancel_reason")
  /// Recibo digital: número correlativo asignado al confirmarse el pago
  receiptNumber Int?          @map("receipt_number")
  paidAt        DateTime?     @map("paid_at")
  /// Quién confirmó el pago (nombre del mesero o "Admin")
  paidBy        String?       @map("paid_by")
  /// Datos opcionales del cliente para el recibo
  customerDoc   String?       @map("customer_doc")
  customerEmail String?       @map("customer_email")
  receiptSentAt DateTime?     @map("receipt_sent_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  note        String?  @map("note")

  order              Order                        @relation(fields: [orderId], references: [id])
  product            Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation          OrderItemVariation?
  removedIngredients OrderItemRemovedIngredient[]
  addedExtras        OrderItemAddedExtra[]
  selections         OrderItemSelection[]

  @@map("order_items")
}

model OrderItemVariation {
  id              String  @id @default(uuid()) @db.Uuid
  orderItemId     String  @unique @map("order_item_id") @db.Uuid
  variationName   String  @map("variation_name")
  additionalPrice Decimal @map("additional_price") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_variations")
}

model OrderItemRemovedIngredient {
  id              String @id @default(uuid()) @db.Uuid
  orderItemId     String  @map("order_item_id") @db.Uuid
  ingredientName  String @map("ingredient_name")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_removed_ingredients")
}

model OrderItemAddedExtra {
  id              String  @id @default(uuid()) @db.Uuid
  orderItemId     String  @map("order_item_id") @db.Uuid
  extraName       String  @map("extra_name")
  price           Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_added_extras")
}

model OrderItemSelection {
  id                 String @id @default(uuid()) @db.Uuid
  orderItemId        String @map("order_item_id") @db.Uuid
  selectionLabel     String @map("selection_label")
  selectedOptionName String @map("selected_option_name")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_selections")
}

enum TableCallType {
  CALL_WAITER
  REQUEST_BILL
}

enum TableCallStatus {
  ACTIVE
  RESOLVED
}

model TableCall {
  id          String          @id @default(uuid()) @db.Uuid
  tableNumber String          @map("table_number")
  type        TableCallType
  status      TableCallStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  resolvedAt  DateTime?       @map("resolved_at")

  @@map("table_calls")
}

model BusinessSettings {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @default("Burger POS")
  logoUrl    String? @map("logo_url")
  tableCount Int     @default(10) @map("table_count")
  /// Bolívares por dólar (0 = no mostrar bolívares)
  exchangeRate   Decimal   @default(0) @map("exchange_rate") @db.Decimal(14, 4)
  rateUpdatedAt  DateTime? @map("rate_updated_at")
  /// Interruptor manual: false = cerrado aunque esté en horario
  isOpen         Boolean   @default(true) @map("is_open")
  /// "HH:MM" en la hora local del negocio; vacío = sin horario
  openTime       String?   @map("open_time")
  closeTime      String?   @map("close_time")
  timezone       String    @default("America/Caracas")
  /// Datos para que el cliente haga el Pago Móvil
  pagoMovilBank  String?   @map("pago_movil_bank")
  pagoMovilPhone String?   @map("pago_movil_phone")
  pagoMovilId    String?   @map("pago_movil_id")
  /// Datos del emisor para el recibo digital
  legalName      String?   @map("legal_name")
  rif            String?
  address        String?
  phone          String?
  /// IVA incluido en los precios (ej. 16). 0 = no desglosar
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  receiptFooter  String?   @map("receipt_footer")
  /// Próximo número de recibo
  nextReceipt    Int       @default(1) @map("next_receipt")

  @@map("business_settings")
}

enum PromotionType {
  PERCENT
  FIXED
}

/// Promoción automática (happy hour, día) o cupón (con code)
model Promotion {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  /// Si tiene código es un cupón; si no, se aplica sola cuando corresponde
  code       String?       @unique
  type       PromotionType @default(PERCENT)
  value      Decimal       @db.Decimal(10, 2)
  /// Solo productos de esta categoría (vacío = todo el pedido)
  categoryId String?       @map("category_id") @db.Uuid
  minTotal   Decimal       @default(0) @map("min_total") @db.Decimal(10, 2)
  /// Días 0-6 (domingo=0); vacío = todos
  days       Int[]         @default([])
  /// Hora inicio/fin (0-24, hora local); null = todo el día
  startHour  Int?          @map("start_hour")
  endHour    Int?          @map("end_hour")
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("promotions")
}

/// Insumo con existencia (ej. "Pan brioche": 40 u)
model InventoryItem {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  quantity  Decimal          @default(0) @db.Decimal(12, 2)
  unit      String           @default("u")
  /// Avisar cuando quede esta cantidad o menos
  lowAt     Decimal          @default(5) @map("low_at") @db.Decimal(12, 2)
  updatedAt DateTime         @updatedAt @map("updated_at")
  usages    InventoryUsage[]

  @@map("inventory_items")
}

/// Cuánto de un insumo usa cada unidad de un producto
model InventoryUsage {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  amount          Decimal       @default(1) @db.Decimal(10, 2)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, productId])
  @@map("inventory_usages")
}

/// Suscripción a notificaciones push (meseros o el cliente de un pedido)
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// "waiter" o "order"
  role      String
  orderId   String?  @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}
